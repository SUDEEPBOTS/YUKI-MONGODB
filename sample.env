# ==============================================================================
# Yuki-Mongo-Render: Configuration Environment
# ==============================================================================

# 1. MongoDB Credentials (Optional but Strongly Recommended for Security)
MONGO_USER=admin
MONGO_PASS=sudeep123

# 2. Custom Domain & Cloudflare DNS Auto-Sync (Optional)
DOMAIN=db.yukiapi.site
CF_KEY=cfk_...
CF_EMAIL=user@example.com
CF_ZONE_ID=e83b7cd90fdda...
TUNNEL_TOKEN=

# 3. Distributed Cloud Storage Vault (Unlimited Storage Replication)
SESSION_STRING=your_vault_session_string
CHANNEL_ID=-100xxxxxxxxxx
API_ID=38674666
API_HASH=b4f0fbf8fb560c4bc9e7b9f3698e474c
SYNC_INTERVAL_MIN=5

# 4. Render Health Port (Injected automatically by Render)
PORT=10000
